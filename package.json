{
  "name": "xat-recreation",
  "version": "1.0.0",
  "description": "Recreation of the xat.com chat platform",
  "main": "src/server/server.js",
  "scripts": {
    "start": "node src/server/server-improved.js",
    "start:old": "node src/server/server.js", 
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon src/server/server-improved.js",
    "dev:client": "webpack serve --mode development",
    "build": "npm run build:client && npm run build:server",
    "build:client": "NODE_ENV=production webpack --mode production",
    "build:server": "mkdir -p dist/server && cp -r src/server dist/",
    "watch": "npm run dev",
    "watch:client": "webpack --mode development --watch",
    "watch:server": "nodemon src/server/server-improved.js",
    "lint": "eslint src/",
    "test": "jest",
    "init-db": "node scripts/init-db.js",
    "import-ixat": "node scripts/sql-to-json-converter.js && node scripts/import-json-to-mongodb.js",
    "setup": "npm install && npm run init-db",
    "serve": "npm run build && node dist/server/server.js",
    "email-webhook": "node src/server/scripts/ultra-simple-email.js",
    "send-verification": "node src/server/scripts/send-verification-email.js",
    "verify-email": "node src/server/scripts/verify-email.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlappyJack212/xat-chat.git"
  },
  "keywords": [
    "xat",
    "chat",
    "websocket",
    "real-time"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ai": "^5.0.34",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-slow-down": "^2.0.0",
    "firebase": "^12.2.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "morgan": "^1.10.0",
    "nodemailer": "^7.0.6",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.1",
    "compression": "^1.7.4",
    "express-validator": "^7.0.1",
    "concurrently": "^8.2.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.2",
    "@babel/preset-env": "^7.23.2",
    "assert": "^2.1.0",
    "babel-loader": "^9.1.3",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "copy-webpack-plugin": "^13.0.1",
    "crypto-browserify": "^3.12.1",
    "css-loader": "^6.8.1",
    "eslint": "^8.52.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.3",
    "https-browserify": "^1.0.0",
    "mini-css-extract-plugin": "^2.7.6",
    "nodemon": "^3.0.1",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "style-loader": "^3.3.3",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
